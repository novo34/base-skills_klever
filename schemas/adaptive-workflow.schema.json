{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/adaptive-workflow.schema.json",
  "title": "JEV Adaptive Workflow",
  "type": "object",
  "required": [
    "workflow_id",
    "task_id",
    "intent_depth",
    "risk",
    "change_radius",
    "capabilities",
    "steps",
    "gates",
    "evidence_requirements",
    "budget_class"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_depth": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "change_radius": {
      "enum": [
        "LOCAL",
        "COMPONENT",
        "CROSS_LAYER",
        "ARCHITECTURAL",
        "PRODUCT"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_class": {
      "enum": [
        "LIGHT",
        "STANDARD",
        "DEEP",
        "CRITICAL"
      ]
    }
  },
  "additionalProperties": false
}
