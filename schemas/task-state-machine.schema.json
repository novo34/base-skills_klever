{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/task-state-machine.schema.json",
  "title": "JEV Task State Machine",
  "type": "object",
  "required": [
    "task_id",
    "state",
    "risk"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "PLANNED",
        "READY",
        "RUNNING",
        "BLOCKED",
        "VERIFYING",
        "FAILED",
        "VERIFIED",
        "STAGING",
        "AWAITING_HUMAN",
        "CHANGES_REQUESTED",
        "APPROVED",
        "REJECTED",
        "DONE"
      ]
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "verification_passed": {
      "type": "boolean"
    },
    "human_approved": {
      "type": "boolean"
    },
    "staging_ready": {
      "type": "boolean"
    },
    "production_promoted": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}