{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/acceptance-contract.schema.json",
  "title": "JEV Acceptance Contract",
  "type": "object",
  "required": [
    "intent_id",
    "acceptance_criteria",
    "constraints",
    "assumptions",
    "non_goals",
    "affected_requirements",
    "compatibility_requirements",
    "required_evidence",
    "unresolved_decisions",
    "specification_depth"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "verification"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specification_depth": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    }
  },
  "additionalProperties": false
}
