{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/execution-plan.schema.json",
  "title": "JEV Execution Plan",
  "type": "object",
  "required": [
    "task_id",
    "risk",
    "agents",
    "skills",
    "model_route",
    "gates"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "model_route": {
      "type": "object"
    },
    "gates": {
      "type": "object",
      "required": [
        "human_approval",
        "verification_required",
        "direct_main_write_allowed"
      ],
      "properties": {
        "human_approval": {
          "type": "boolean"
        },
        "verification_required": {
          "type": "boolean"
        },
        "direct_main_write_allowed": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}