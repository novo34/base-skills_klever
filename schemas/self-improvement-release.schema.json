{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/self-improvement-release.schema.json",
  "title": "JEV Self Improvement Release",
  "type": "object",
  "required": [
    "candidate_id",
    "benchmark_report",
    "human_approval",
    "canary_scope",
    "rollback_proof",
    "monitoring_metrics",
    "canary_result",
    "promotion_status"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_report": {
      "type": "string",
      "minLength": 1
    },
    "human_approval": {
      "type": "boolean"
    },
    "canary_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollback_proof": {
      "type": "string",
      "minLength": 1
    },
    "monitoring_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "canary_result": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL"
      ]
    },
    "promotion_status": {
      "enum": [
        "CANDIDATE",
        "APPROVED_FOR_CANARY",
        "CANARY_RUNNING",
        "ROLLED_BACK",
        "READY_TO_PROMOTE",
        "PROMOTED"
      ]
    }
  },
  "additionalProperties": false
}
