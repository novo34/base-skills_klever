{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/work-order.schema.json",
  "title": "JEV Work Order",
  "type": "object",
  "required": [
    "order_id",
    "project_id",
    "title",
    "description",
    "status",
    "priority"
  ],
  "properties": {
    "order_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "QUEUED",
        "PLANNED",
        "RUNNING",
        "VERIFYING",
        "STAGING",
        "AWAITING_HUMAN",
        "CHANGES_REQUESTED",
        "APPROVED",
        "REJECTED",
        "DONE",
        "BLOCKED"
      ]
    },
    "priority": {
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "URGENT"
      ]
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created_by": {
      "type": "string"
    },
    "budget_limit_chf": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "target_repository": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}