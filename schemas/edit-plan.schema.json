{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/edit-plan.schema.json",
  "title": "JEV Developer Edit Plan",
  "type": "object",
  "required": [
    "task_id",
    "workspace_id",
    "branch",
    "edits"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "operation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "CREATE",
              "UPDATE",
              "DELETE"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}