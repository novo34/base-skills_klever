{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/task.schema.json",
  "title": "JEV Task",
  "type": "object",
  "required": [
    "id",
    "requirement_ids",
    "risk",
    "status",
    "branch"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "RUNNING",
        "BLOCKED",
        "VERIFYING",
        "FAILED",
        "VERIFIED",
        "STAGING",
        "AWAITING_HUMAN",
        "CHANGES_REQUESTED",
        "APPROVED",
        "REJECTED",
        "DONE"
      ]
    },
    "branch": {
      "type": "string"
    },
    "max_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "max_actions": {
      "type": "integer",
      "minimum": 1
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0
    },
    "max_cost_chf": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": true
}