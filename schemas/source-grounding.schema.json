{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/source-grounding.schema.json",
  "title": "JEV Source Grounding",
  "type": "object",
  "required": [
    "inspected_sources",
    "existing_candidates",
    "reuse_decision",
    "creation_decisions",
    "compatibility_constraints",
    "provenance_notes",
    "unknowns"
  ],
  "properties": {
    "inspected_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "existing_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reuse_decision": {
      "enum": [
        "REUSE",
        "EXTEND",
        "CREATE_NEW",
        "NO_IMPLEMENTATION"
      ]
    },
    "creation_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "proposed_surface",
          "searched_equivalents",
          "rationale",
          "reuse_rejected_because"
        ],
        "properties": {
          "proposed_surface": {
            "type": "string"
          },
          "searched_equivalents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "reuse_rejected_because": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "compatibility_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
