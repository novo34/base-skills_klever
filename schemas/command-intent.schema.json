{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/command-intent.schema.json",
  "title": "JEV Command Intent",
  "type": "object",
  "required": [
    "intent_id",
    "actor",
    "text",
    "confidence",
    "requires_confirmation"
  ],
  "properties": {
    "intent_id": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}