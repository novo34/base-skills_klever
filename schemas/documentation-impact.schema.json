{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/documentation-impact.schema.json",
  "title": "JEV Documentation Impact",
  "type": "object",
  "required": [
    "change_id",
    "affected_artifacts",
    "required_updates",
    "optional_updates",
    "no_change_rationale",
    "trace_links",
    "drift_findings"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "affected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_updates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "optional_updates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "no_change_rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace_links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "drift_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
