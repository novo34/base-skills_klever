{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/decision.schema.json",
  "title": "JEV Decision",
  "type": "object",
  "required": [
    "id",
    "topic",
    "risk",
    "method",
    "status",
    "locked"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "method": {
      "enum": [
        "single_agent",
        "developer_verifier",
        "multi_agent_review",
        "weighted_consensus",
        "unanimity",
        "human_tiebreak"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "VOTING",
        "APPROVED",
        "REJECTED",
        "LOCKED",
        "REOPENED"
      ]
    },
    "locked": {
      "type": "boolean"
    },
    "human_approval_required": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string"
    },
    "dissent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}