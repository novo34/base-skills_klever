{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/lock.schema.json",
  "title": "JEV Resource Lock",
  "type": "object",
  "required": [
    "resource",
    "owner",
    "task_id",
    "status"
  ],
  "properties": {
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "RELEASED",
        "EXPIRED"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}