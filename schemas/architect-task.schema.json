{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/architect-task.schema.json",
  "title": "JEV Architect Task",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "objective",
    "constraints",
    "requirement_ids",
    "provider",
    "model"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "fallback_chain": {
      "type": "array"
    }
  },
  "additionalProperties": false
}