{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/simplification-report.schema.json",
  "title": "JEV Simplification Report",
  "type": "object",
  "required": [
    "behavior_preserved_evidence",
    "complexity_before_after",
    "duplication_before_after",
    "cleanup_accounting",
    "compatibility_justifications",
    "residual_debt"
  ],
  "properties": {
    "behavior_preserved_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "complexity_before_after": {
      "type": "string"
    },
    "duplication_before_after": {
      "type": "string"
    },
    "cleanup_accounting": {
      "type": "object",
      "required": [
        "added",
        "replaced",
        "removed",
        "retained_for_compatibility",
        "follow_up_cleanup"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replaced": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retained_for_compatibility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "follow_up_cleanup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "compatibility_justifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_debt": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
