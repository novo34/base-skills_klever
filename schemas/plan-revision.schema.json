{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/plan-revision.schema.json",
  "title": "JEV Plan Revision",
  "type": "object",
  "required": [
    "revision_id",
    "blueprint_id",
    "from_revision",
    "to_revision",
    "actor",
    "reason",
    "evidence",
    "operations",
    "dependency_impact",
    "risk_impact",
    "budget_impact"
  ],
  "properties": {
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "blueprint_id": {
      "type": "string",
      "minLength": 1
    },
    "from_revision": {
      "type": "integer",
      "minimum": 1
    },
    "to_revision": {
      "type": "integer",
      "minimum": 2
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operation",
          "step_id"
        ],
        "properties": {
          "operation": {
            "enum": [
              "INSERT",
              "SPLIT",
              "REORDER",
              "BLOCK",
              "REPLACE",
              "REMOVE"
            ]
          },
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "replacement_step_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dependency_impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_impact": {
      "type": "string",
      "minLength": 1
    },
    "budget_impact": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
