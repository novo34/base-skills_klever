{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klever.local/schemas/context-retrieval-plan.schema.json",
  "title": "JEV Context Retrieval Plan",
  "type": "object",
  "required": [
    "task_id",
    "budget",
    "max_iterations",
    "required_queries",
    "optional_queries",
    "stop_when"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "integer",
      "minimum": 1
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "required_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
